# PostgreSQL connection
DATABASE_URL="postgresql://leadstabo:leadstabo@localhost:5432/leadstabo?schema=public"

# 32+ byte random secret used to sign sessions and encrypt stored provider credentials.
# Generate with: openssl rand -base64 32
APP_SECRET="change-me-to-a-long-random-string-of-32-bytes-min"

# Public base URL (used for links in emails / tracking)
APP_URL="http://localhost:3000"

# Provider selection. "mock" works offline; swap for real adapters later.
EMAIL_PROVIDER="mock"
VERIFICATION_PROVIDER="mock"
LEADS_PROVIDER="mock"
DNS_PROVIDER="mock"
PAYMENTS_PROVIDER="mock"
AI_PROVIDER="mock" # set to "anthropic" (with ANTHROPIC_API_KEY) to use Claude

# Optional: real AI provider key (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=""
