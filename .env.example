# ── Core ─────────────────────────────────────────────────────────────
# PostgreSQL connection. Use a database dedicated to Leadabo.
# On Neon, use the direct host (without "-pooler") so migrations work, and add
# &connect_timeout=30 so the app waits for a sleeping database to wake up.
DATABASE_URL="postgresql://leadstabo:leadstabo@localhost:5432/leadstabo?schema=public"

# 32+ byte random secret: signs tracking links and encrypts stored mailbox passwords.
# Generate with: openssl rand -base64 32   (changing it invalidates stored inbox credentials)
APP_SECRET="change-me-to-a-long-random-string-of-32-bytes-min"

# Public URL of this deployment. Must be reachable from the internet for open/click
# tracking and payment redirects/webhooks (http://localhost:3000 works for everything else).
APP_URL="http://localhost:3000"

# Protects POST /api/cron/tick (for serverless schedulers instead of `npm run worker`)
CRON_SECRET="change-me"

# ── Real services (each switches on when its key is set) ─────────────
# Email sending & reply sync use each inbox's own SMTP/IMAP credentials — no key needed.
# Domain DNS checks use live DNS — no key needed.

# Lead database: Apollo.io (plan with API access). Without it a demo dataset is used.
APOLLO_API_KEY=""

# Mailbox-level email verification. Without it, live DNS/MX checks are used.
ZEROBOUNCE_API_KEY=""

# Payments in Naira (NGN) and US Dollars (USD). Set any one or more gateways.
# Webhook URLs to paste in each dashboard: <APP_URL>/api/webhooks/paystack | flutterwave | korapay
# With no keys set, a free test checkout is used in development only.
PAYSTACK_SECRET_KEY=""          # sk_test_… / sk_live_…
FLUTTERWAVE_SECRET_KEY=""       # FLWSECK_TEST-… / FLWSECK-…
FLUTTERWAVE_WEBHOOK_HASH=""     # the "Secret hash" you type in Flutterwave → Settings → Webhooks
KORAPAY_SECRET_KEY=""           # sk_test_… / sk_live_…
# Which currencies each gateway may charge (defaults: Paystack NGN,USD · Flutterwave NGN,USD · Korapay NGN).
# Only list USD if your merchant account has USD enabled.
# PAYSTACK_CURRENCIES="NGN,USD"
# FLUTTERWAVE_CURRENCIES="NGN,USD"
# KORAPAY_CURRENCIES="NGN"
# PAYMENTS_TEST_MODE=true       # allow the free test checkout in production (demos only!)

# AI writing & reply classification with Claude. Without it, templates are used.
ANTHROPIC_API_KEY=""

# ── Optional: force offline mocks for local demos ────────────────────
# EMAIL_PROVIDER=mock
# VERIFICATION_PROVIDER=mock
# LEADS_PROVIDER=mock
# DNS_PROVIDER=mock
# PAYMENTS_PROVIDER=none   # hide checkout entirely
# AI_PROVIDER=mock
